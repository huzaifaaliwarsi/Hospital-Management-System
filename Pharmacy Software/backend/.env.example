NODE_ENV=development
PORT=4100

DATABASE_URL=postgresql://user:password@host/pharmacy_db?sslmode=require
DATABASE_POOL_MAX=10

JWT_ACCESS_SECRET=change-me-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-min-16-chars
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost

CORS_ALLOWED_ORIGINS=http://localhost:5180

SUPER_ADMIN_EMAIL=superadmin@pharmacy.example
SUPER_ADMIN_BOOTSTRAP_PASSWORD=change-me

LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50
