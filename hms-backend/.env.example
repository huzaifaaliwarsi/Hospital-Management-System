# ──────────────────────────────────────────────────────────────────────────
# CH Sharif and Saeed Hospital — HMS Backend — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# See PROJECT_MASTER_SPEC.md §7.2 for the full description of each variable.
# ──────────────────────────────────────────────────────────────────────────

# --- Runtime -----------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) ----------------------------------------------
DATABASE_URL=postgresql://hms_app:changeme@localhost:5432/chss_hms?schema=public
DATABASE_POOL_MAX=20

# --- Auth / JWT ----------------------------------------------------------
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost

# --- CORS ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- File storage ------------------------------------------------------
FILE_STORAGE_DRIVER=local
FILE_STORAGE_BUCKET=

# --- Bootstrap accounts (dev/staging seed only; rotate after first login) --
# Per PROJECT_MASTER_SPEC.md §6.17: this is the ONLY way a Super Admin is
# ever created outside the running application. A second Super Admin must
# be created by an existing Super Admin through the UI/API, never by
# re-running this seed.
SUPER_ADMIN_EMAIL=superadmin@chss.example
SUPER_ADMIN_BOOTSTRAP_PASSWORD=changeme-bootstrap-password
ADMIN_EMAIL=admin@chss.example
ADMIN_BOOTSTRAP_PASSWORD=changeme-admin-password

# --- Logging -----------------------------------------------------------
LOG_LEVEL=info

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# --- Attendance device adapter (D16 p.19, p.28 — final method TBD) -------
# One of: api | sdk | lan_sync | file_import
ATTENDANCE_DEVICE_ADAPTER=file_import
