# ==============================================================================
# PHARMACY BACKEND PRODUCTION CONFIGURATION (.env)
# ==============================================================================

NODE_ENV=production
PORT=4100

# Database Configuration (PostgreSQL on cPanel or Cloud DB)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
DATABASE_POOL_MAX=10

# Security - Generate high-entropy random keys (e.g. openssl rand -hex 32)
JWT_ACCESS_SECRET="generate_32_char_random_hex_string_access"
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET="generate_32_char_random_hex_string_refresh"
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN="yourdomain.com"

# CORS Origins (Comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS="https://pharmacy.yourdomain.com"

# Default Super Admin Account Seed (Used by seed script)
SUPER_ADMIN_EMAIL=superadmin@pharmacy.example
SUPER_ADMIN_BOOTSTRAP_PASSWORD=ChangeThisPassword@123

LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50

# ==============================================================================
# HMS CROSS-SYSTEM BRIDGE INTEGRATION
# ==============================================================================
# HMS_BACKEND_URL: Jab HMS deploy ho jaye, uska backend URL yahan daalein.
# Standalone chalane ke liye default rehne dein (Pharmacy crash nahi hogi).
HMS_BACKEND_URL="http://localhost:4000/api/v1"

# Shared Mutual Auth Secret (Dono HMS aur Pharmacy ke .env mein exact same honi chahiye)
INTERNAL_BRIDGE_SECRET="generate_strong_unique_shared_secret_2026"

